# --- Comun -----------------------------------------------------------------
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/appointments_saas?schema=public
# Base64 de 32 bytes aleatorios: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=replace_with_32_random_bytes_base64

# --- API -------------------------------------------------------------------
PORT=4000
# En produccion: valor aleatorio de al menos 32 caracteres (la API no arranca con uno debil).
JWT_SECRET=changeme_super_secret
ADMIN_JWT_EXPIRES_IN=12h
BOOKING_JWT_EXPIRES_IN=30d
OTP_EXPIRY_MINUTES=5
PRODUCT_NAME=Agenda de Citas
ADMIN_BASE_URL=http://localhost:5173
PUBLIC_BOOKING_BASE_URL=http://localhost:5174
API_PUBLIC_BASE_URL=http://localhost:4000
# Lista separada por comas; si se omite, en produccion se usan ADMIN_BASE_URL y PUBLIC_BOOKING_BASE_URL.
CORS_ORIGINS=
# Documentacion OpenAPI en /docs (por defecto solo fuera de produccion).
API_DOCS_ENABLED=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/integrations/google/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Worker de notificaciones ----------------------------------------------
# "log" solo registra los envios; "live" contacta a los proveedores. Por defecto: live en
# produccion y log en cualquier otro entorno, para no enviar mensajes reales por accidente.
WORKER_SEND_MODE=
WORKER_POLL_INTERVAL_MS=15000
WORKER_BATCH_SIZE=25
SENDGRID_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Agenda de Citas
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Operacion ---------------------------------------------------------------
# Detras de un proxy (Caddy en produccion): "1". Sin proxy: "false".
TRUST_PROXY=false
# Limites de intentos compartidos entre instancias de la API (opcional con una sola).
# Para probarlo en local: `docker compose up -d redis` y REDIS_URL=redis://localhost:6379
REDIS_URL=
# Reporte de errores a Sentry (opcional; vacio = desactivado).
SENTRY_DSN=
SENTRY_ENVIRONMENT=

# --- Datos de desarrollo (seed) --------------------------------------------
DEFAULT_TENANT_SLUG=demo-barberia
DEFAULT_TENANT_ID=11111111-1111-1111-1111-111111111111
