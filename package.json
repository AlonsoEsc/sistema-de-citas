{
  "name": "sistema-citas-saas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm --workspace apps/api run dev",
    "dev:worker": "npm --workspace apps/worker run dev",
    "dev:admin": "npm --workspace apps/web-admin run dev",
    "dev:booking": "npm --workspace apps/web-booking run dev",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:worker\" \"npm run dev:admin\" \"npm run dev:booking\"",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm test",
    "db:generate": "npm --workspace packages/db run generate",
    "db:migrate": "npm --workspace packages/db run migrate:dev",
    "db:deploy": "npm --workspace packages/db run migrate:deploy",
    "db:seed": "npm --workspace packages/db run seed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.0.1",
    "globals": "^17.7.0",
    "prettier": "^3.4.2",
    "typescript-eslint": "^8.64.0"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
