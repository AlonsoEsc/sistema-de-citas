{
  "name": "sistema-citas-saas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm --workspace apps/api run dev",
    "dev:worker": "npm --workspace apps/worker run dev",
    "dev:admin": "npm --workspace apps/web-admin run dev",
    "dev:booking": "npm --workspace apps/web-booking run dev",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:worker\" \"npm run dev:admin\" \"npm run dev:booking\"",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "format": "npm run format --workspaces"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.0.1",
    "globals": "^17.7.0",
    "typescript-eslint": "^8.64.0"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
