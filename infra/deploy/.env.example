# Copiar a .env en el servidor y completar. Nunca versionar el .env real.

# --- Version a desplegar ----------------------------------------------------
# Prefijo de las imagenes (registro) y etiqueta. El flujo de GitHub publica en
# ghcr.io/<usuario>/<repo> con la etiqueta del commit o de la version.
IMAGE_PREFIX=ghcr.io/usuario/sistemadecitas
IMAGE_TAG=latest
# Etiqueta de la imagen web de este entorno (deploy.sh la fija en cada despliegue).
WEB_IMAGE_TAG=latest-production
DEPLOY_ENVIRONMENT=production

# --- Dominios (deben apuntar a la IP del servidor antes de arrancar) ---------
ADMIN_SITE=app.tudominio.com
BOOKING_SITE=reservas.tudominio.com
API_SITE=api.tudominio.com
# Correo para Let's Encrypt (avisos de vencimiento de certificados).
ACME_EMAIL=ops@tudominio.com

# --- Base de datos ----------------------------------------------------------
POSTGRES_USER=citas
# openssl rand -base64 32
POSTGRES_PASSWORD=
POSTGRES_DB=citas

# --- Secretos de la aplicacion ----------------------------------------------
# openssl rand -base64 48
JWT_SECRET=
# openssl rand -base64 32  (exactamente 32 bytes; no cambiarla despues: cifra credenciales)
ENCRYPTION_KEY=

PRODUCT_NAME=Agenda de Citas

# --- Proveedores ------------------------------------------------------------
SENDGRID_API_KEY=
EMAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# "live" envia mensajes reales. En staging conviene "log".
WORKER_SEND_MODE=live

# --- Escalado (opcional) -----------------------------------------------------
# Con mas de una instancia de la API, un Redis comparte los limites de intentos.
REDIS_URL=

# --- Monitoreo (opcional) ----------------------------------------------------
# Proyecto Node de Sentry (api y worker) y proyecto React (panel y portal).
SENTRY_DSN=
VITE_SENTRY_DSN=

# --- Datos legales (aparecen en Terminos y Privacidad) ------------------------
LEGAL_NAME=
LEGAL_EMAIL=
LEGAL_ADDRESS=

# --- Respaldos ---------------------------------------------------------------
# Carpeta del servidor donde quedan los respaldos. Copiala fuera del servidor
# (ver docs/operations.md): un respaldo en el mismo disco no protege de perderlo.
BACKUP_HOST_DIR=./backups
BACKUP_RETENTION_DAYS=14
BACKUP_SCHEDULE=0 3 * * *
RESTORE_TEST_SCHEDULE=0 4 * * 0
TZ=America/El_Salvador
