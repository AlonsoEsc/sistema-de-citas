# Generate every secret independently. Do not reuse these example values.
EVOLUTION_POSTGRES_PASSWORD=replace_with_strong_password
EVOLUTION_REDIS_PASSWORD=replace_with_strong_password
AUTHENTICATION_API_KEY=replace_with_32_or_more_random_characters
SERVER_URL=http://localhost:8081
SERVER_PORT=8080
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://evolution:replace_with_strong_password@evolution-postgres:5432/evolution
DATABASE_CONNECTION_CLIENT_NAME=evolution
CACHE_REDIS_ENABLED=false
CACHE_REDIS_URI=redis://:replace_with_strong_password@evolution-redis:6379/0
CACHE_REDIS_PREFIX_KEY=evolution
CACHE_LOCAL_ENABLED=true
TELEMETRY_ENABLED=false
DEL_INSTANCE=false

CHATWOOT_POSTGRES_PASSWORD=replace_with_another_strong_password
CHATWOOT_REDIS_PASSWORD=replace_with_another_strong_password
POSTGRES_HOST=chatwoot-postgres
POSTGRES_DATABASE=chatwoot
POSTGRES_USERNAME=chatwoot
POSTGRES_PASSWORD=replace_with_another_strong_password
REDIS_URL=redis://:replace_with_another_strong_password@chatwoot-redis:6379
REDIS_PASSWORD=replace_with_another_strong_password
SECRET_KEY_BASE=replace_with_at_least_64_random_hex_characters
FRONTEND_URL=http://localhost:3000
RAILS_ENV=production
NODE_ENV=production
INSTALLATION_ENV=docker
ENABLE_ACCOUNT_SIGNUP=false
ACTIVE_STORAGE_SERVICE=local
